{
  "name": "@civic-pulse/event-dispatcher-worker",
  "version": "0.1.0",
  "private": true,
  "description": "CivicPulse BullMQ Outbox Event Dispatcher Worker",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@civic-pulse/contracts": "*",
    "@civic-pulse/nest-common": "*",
    "bullmq": "^5.34.11",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@civic-pulse/tsconfig": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
