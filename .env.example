# ==============================================================================
# CivicPulse Environment Configuration Template
# All secrets and environment variables MUST use placeholders in this file.
# Copy this file to .env before starting the services or infrastructure.
# ==============================================================================

# Global Environment
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Infrastructure - MongoDB (Local Dev Credentials)
# Notice: In local dev, each service accesses its own logical database.
# ------------------------------------------------------------------------------
MONGO_ROOT_USER=civic_admin
MONGO_ROOT_PASSWORD=civic_dev_secret_password
MONGO_HOST=localhost
MONGO_PORT=27018

# Service-specific logical database connection strings
IDENTITY_DB_URI=mongodb://civic_identity_user:identity_dev_secret@localhost:27018/civic_identity?authSource=civic_identity
REPORTS_DB_URI=mongodb://civic_reports_user:reports_dev_secret@localhost:27018/civic_reports?authSource=civic_reports
COMMUNITY_DB_URI=mongodb://civic_community_user:community_dev_secret@localhost:27018/civic_community?authSource=civic_community
AUTHORITY_DB_URI=mongodb://civic_authority_user:authority_dev_secret@localhost:27018/civic_authority?authSource=civic_authority
MODERATION_DB_URI=mongodb://civic_moderation_user:moderation_dev_secret@localhost:27018/civic_moderation?authSource=civic_moderation

# ------------------------------------------------------------------------------
# Infrastructure - Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_dev_secret_password

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
REPORTS_SERVICE_PORT=3002
COMMUNITY_SERVICE_PORT=3003
AUTHORITY_SERVICE_PORT=3004
MEDIA_SERVICE_PORT=3005
NOTIFICATIONS_SERVICE_PORT=3006
AI_SERVICE_PORT=3007
SOCIAL_PUBLISHING_SERVICE_PORT=3008
MODERATION_SERVICE_PORT=3009

# ------------------------------------------------------------------------------
# Routing & Service URLs (API Gateway)
# ------------------------------------------------------------------------------
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
REPORTS_SERVICE_URL=http://127.0.0.1:3002
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006
INTERNAL_SERVICE_KEY=civic_pulse_internal_service_secret_dev

# ------------------------------------------------------------------------------
# Authentication & JWT RS256 Settings
# Note: In development, Identity Service dynamically generates an RSA pair if omitted.
# In production, set both PEM keys securely in secrets manager.
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY_PEM=placeholder_rsa_private_key_pem
JWT_PUBLIC_KEY_PEM=placeholder_rsa_public_key_pem
JWT_ISSUER=civic-pulse:identity
JWT_AUDIENCE=civic-pulse:api
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ------------------------------------------------------------------------------
# Future Providers (Placeholders for upcoming phases)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

FIREBASE_PROJECT_ID=placeholder_firebase_project_id
FIREBASE_CLIENT_EMAIL=placeholder_firebase_client_email
FIREBASE_PRIVATE_KEY="placeholder_firebase_private_key"
